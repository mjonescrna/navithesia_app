  // Helper method to map anatomical categories from the procedure database
  void _mapAnatomicalCategories(String anatomicalCategory) {
    final String categoryLower = anatomicalCategory.toLowerCase();
    Logger.debug('Mapping anatomical category: $categoryLower');

    // Define anatomical category mappings - using official COA requirement names
    final Map<String, List<String>> anatomicalMappings = {
      'head': ['Intracranial'],
      'neck': ['Neck'],
      'chest': ['Intrathoracic'],
      'abdomen': ['Intraabdominal'],
      'spine': ['Neuroskeletal (spine)'],
      'upper extremity': ['Upper Extremity'],
      'lower extremity': ['Lower Extremity'],
      'face': ['Oropharyngeal'],
      'oral': ['Oropharyngeal'],
      'nasal': ['Oropharyngeal'],
      'ophthalmic': ['Oropharyngeal'],
      'ear': ['Oropharyngeal'],
      'nose': ['Oropharyngeal'],
      'throat': ['Oropharyngeal'],
      'breast': ['Intraabdominal'],
      'cardiac': ['Heart'],
      'thoracic': ['Intrathoracic'],
      'vascular': ['Vascular'],
      'orthopedic': ['Neuroskeletal (spine)'],
      'urologic': ['Intraabdominal'],
      'gynecologic': ['Intraabdominal'],
      'obstetric': ['Obstetrical management'],
      'pediatric': ['Pediatric 2-12 years'],
      'trauma': ['Trauma/Emergency (E)'],
      'emergency': ['Trauma/Emergency (E)'],
      'laparoscopic': ['Intraabdominal'],
    };

    // Check for each anatomical category
    anatomicalMappings.forEach((key, categories) {
      if (categoryLower.contains(key)) {
        categories.forEach((category) {
          _addCategoryByName(category);
        });
      }
    });

    // Special handling for combined categories
    if (categoryLower.contains('cardiac') &&
        categoryLower.contains('thoracic')) {
      _addCategoryByName('Heart');
      _addCategoryByName('Intrathoracic');
    }

    if (categoryLower.contains('vascular') &&
        categoryLower.contains('interventional')) {
      _addCategoryByName('Vascular');
    }
  }

  // Helper method to add anesthesia type
  void _addAnesthesiaType(String typeId) {
    setState(() {
      if (!_selectedAnesthesiaTypes.contains(typeId)) {
        _selectedAnesthesiaTypes.add(typeId);
        _updateCategoriesBasedOnAnesthesiaTypes();
      }
    });
  }
}
