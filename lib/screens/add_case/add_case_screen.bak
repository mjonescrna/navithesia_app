        _buildThemeAwareSwitch(
          value: _isEmergency,
          onChanged: (value) {
            setState(() {
              _isEmergency = value;
              if (value) {
                // Add the trauma/emergency category
                _addCategoryByName('Trauma / Emergency (E)');
              } else {
                // Remove the trauma/emergency category
                _selectedCategories.removeWhere(
                  (c) => c.id == 'trauma_emergency',
                );
              }
